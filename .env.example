# Local-only defaults. Set different strong values before exposing a deployment.
PROPADMIN_DATA_PATH=.data/state.json
ADMIN_PASSWORD=propadmin-local
TOKEN_SECRET=local-development-signing-key
INTERNAL_SERVICE_TOKEN=local-internal-token
API_URL=http://localhost:8000
PROPADMIN_MODE=local
# Pipeline providers remain unavailable until credentials are configured.
ANTHROPIC_API_KEY=
PIPELINE_MODEL=
SURREAL_URL=http://localhost:8008
SURREAL_NAMESPACE=propadmin
SURREAL_DATABASE=propadmin
SURREAL_USER=root
SURREAL_PASSWORD=local-surreal
GOOGLE_CLOUD_PROJECT=
# Leave empty locally; Cloud Run Terraform configures the existing artifacts bucket.
OBSERVABILITY_ARTIFACT_BUCKET=
VERTEX_LOCATION=us-central1
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Voice: import the existing Vonage number into ElevenLabs as a SIP trunk number.
# This ID is returned by ElevenLabs; it is not the phone number or Vonage API key.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_WEBHOOK_SECRET=
# Google Chat webhook for new landing signups. Leave empty locally to avoid pinging the team.
SIGNUP_WEBHOOK_URL=
