-- Source evidence, hybrid search and versioned rule relations. SurrealDB >=3.0.
BEGIN TRANSACTION;
DEFINE TABLE OVERWRITE source_file SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE filename ON source_file TYPE string;
DEFINE FIELD OVERWRITE mime ON source_file TYPE string;
DEFINE FIELD OVERWRITE sha256 ON source_file TYPE string;
DEFINE FIELD OVERWRITE gcs_uri ON source_file TYPE option<string>;
DEFINE FIELD OVERWRITE origin ON source_file TYPE string;
DEFINE FIELD OVERWRITE text ON source_file TYPE string DEFAULT '';
DEFINE FIELD OVERWRITE size ON source_file TYPE int DEFAULT 0;
DEFINE FIELD OVERWRITE received_at ON source_file TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE extractor_version ON source_file TYPE string DEFAULT '1';
DEFINE INDEX OVERWRITE source_sha ON source_file FIELDS sha256 UNIQUE;
DEFINE TABLE OVERWRITE chunk SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE ordinal ON chunk TYPE int;
DEFINE FIELD OVERWRITE text ON chunk TYPE string;
DEFINE FIELD OVERWRITE source ON chunk TYPE record<source_file>;
DEFINE FIELD OVERWRITE page ON chunk TYPE option<int>;
DEFINE FIELD OVERWRITE char_start ON chunk TYPE option<int>;
DEFINE FIELD OVERWRITE char_end ON chunk TYPE option<int>;
DEFINE FIELD OVERWRITE start_ms ON chunk TYPE option<int>;
DEFINE FIELD OVERWRITE end_ms ON chunk TYPE option<int>;
DEFINE INDEX OVERWRITE chunk_ordinal ON chunk FIELDS source, ordinal UNIQUE;
DEFINE TABLE OVERWRITE contains SCHEMAFULL TYPE RELATION IN source_file OUT chunk ENFORCED;
DEFINE TABLE OVERWRITE next SCHEMAFULL TYPE RELATION IN chunk OUT chunk ENFORCED;
DEFINE TABLE OVERWRITE derived_from SCHEMAFULL TYPE RELATION IN email | call OUT source_file ENFORCED;
DEFINE TABLE OVERWRITE mentions SCHEMAFULL TYPE RELATION IN chunk OUT person | company | ticket | email | call ENFORCED CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE span ON mentions TYPE object;
DEFINE FIELD OVERWRITE span.start ON mentions TYPE int;
DEFINE FIELD OVERWRITE span.end ON mentions TYPE int;
DEFINE FIELD OVERWRITE span.text ON mentions TYPE string;
DEFINE FIELD OVERWRITE confidence ON mentions TYPE float ASSERT $value >= 0 AND $value <= 1;
DEFINE FIELD OVERWRITE extractor_version ON mentions TYPE string;
DEFINE INDEX OVERWRITE mention_span ON mentions FIELDS in, out, span.start, span.end, extractor_version UNIQUE;
DEFINE TABLE OVERWRITE fact SCHEMAFULL;
DEFINE FIELD OVERWRITE entity ON fact TYPE record;
DEFINE FIELD OVERWRITE field ON fact TYPE string;
DEFINE FIELD OVERWRITE value ON fact TYPE string;
DEFINE FIELD OVERWRITE chunk ON fact TYPE option<record<chunk>>;
DEFINE FIELD OVERWRITE confidence ON fact TYPE float;
DEFINE FIELD OVERWRITE span_start ON fact TYPE option<int>;
DEFINE FIELD OVERWRITE span_end ON fact TYPE option<int>;
DEFINE FIELD OVERWRITE valid_from ON fact TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE valid_to ON fact TYPE option<datetime>;
DEFINE TABLE OVERWRITE hard_key SCHEMAFULL;
DEFINE FIELD OVERWRITE entity ON hard_key TYPE record;
DEFINE FIELD OVERWRITE kind ON hard_key TYPE string;
DEFINE FIELD OVERWRITE value ON hard_key TYPE string;
DEFINE INDEX OVERWRITE hard_key_unique ON hard_key FIELDS kind, value UNIQUE;
DEFINE TABLE OVERWRITE embedding SCHEMAFULL CHANGEFEED 7d;
DEFINE FIELD OVERWRITE owner ON embedding TYPE record;
DEFINE FIELD OVERWRITE field ON embedding TYPE string;
DEFINE FIELD OVERWRITE ordinal ON embedding TYPE int DEFAULT 0;
DEFINE FIELD OVERWRITE text ON embedding TYPE string;
DEFINE FIELD OVERWRITE vector ON embedding TYPE array<float,1536>;
DEFINE FIELD OVERWRITE model ON embedding TYPE string;
DEFINE FIELD OVERWRITE version ON embedding TYPE int DEFAULT 1;
DEFINE INDEX OVERWRITE embedding_owner ON embedding FIELDS owner, field, ordinal UNIQUE;
DEFINE INDEX OVERWRITE embedding_vector ON embedding FIELDS vector HNSW DIMENSION 1536 DIST COSINE;
DEFINE ANALYZER OVERWRITE english TOKENIZERS class FILTERS lowercase, snowball(english);
DEFINE INDEX OVERWRITE embedding_text ON embedding FIELDS text FULLTEXT ANALYZER english BM25 HIGHLIGHTS;
DEFINE TABLE OVERWRITE edge_rule SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE name ON edge_rule TYPE string;
DEFINE FIELD OVERWRITE relation ON edge_rule TYPE string;
DEFINE FIELD OVERWRITE from_type ON edge_rule TYPE string;
DEFINE FIELD OVERWRITE to_type ON edge_rule TYPE string;
DEFINE FIELD OVERWRITE kind ON edge_rule TYPE string ASSERT $value IN ['field_match','field_overlap','expression','co_occurrence','similarity','llm_judge'];
DEFINE FIELD OVERWRITE prompt ON edge_rule TYPE string DEFAULT '';
-- Params remain a typed configuration object; runtime validates keys by rule kind.
DEFINE FIELD OVERWRITE params ON edge_rule TYPE object FLEXIBLE;
DEFINE FIELD OVERWRITE enabled ON edge_rule TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE version ON edge_rule TYPE int DEFAULT 1;
DEFINE FIELD OVERWRITE compiled ON edge_rule TYPE string DEFAULT '';
DEFINE TABLE OVERWRITE edge SCHEMAFULL TYPE RELATION CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE relation ON edge TYPE string;
DEFINE FIELD OVERWRITE rule ON edge TYPE option<record<edge_rule>>;
DEFINE FIELD OVERWRITE rule_version ON edge TYPE option<int>;
DEFINE FIELD OVERWRITE score ON edge TYPE option<float>;
DEFINE FIELD OVERWRITE evidence ON edge TYPE array<record<chunk>> DEFAULT [];
DEFINE FIELD OVERWRITE computed_at ON edge TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE valid_from ON edge TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE valid_to ON edge TYPE option<datetime>;
DEFINE INDEX OVERWRITE edge_identity ON edge FIELDS in, out, relation, rule UNIQUE;
COMMIT TRANSACTION;
