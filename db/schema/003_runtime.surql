-- Durable session ownership, plans, reversible audit and wake-up idempotency.
BEGIN TRANSACTION;
DEFINE TABLE OVERWRITE agent_run SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE goal ON agent_run TYPE string;
DEFINE FIELD OVERWRITE status ON agent_run TYPE string ASSERT $value IN ['queued','running','sleeping','done','failed','cancelled'];
DEFINE FIELD OVERWRITE subjects ON agent_run TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE provider ON agent_run TYPE string;
DEFINE FIELD OVERWRITE provider_session_id ON agent_run TYPE option<string>;
DEFINE FIELD OVERWRITE skill_versions ON agent_run TYPE array<record<skill_version>> DEFAULT [];
DEFINE FIELD OVERWRITE next_wake_at ON agent_run TYPE option<datetime>;
DEFINE FIELD OVERWRITE created_at ON agent_run TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE updated_at ON agent_run TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE version ON agent_run TYPE int DEFAULT 1;
DEFINE TABLE OVERWRITE claim SCHEMAFULL;
DEFINE FIELD OVERWRITE subject ON claim TYPE string;
DEFINE FIELD OVERWRITE run ON claim TYPE record<agent_run>;
DEFINE FIELD OVERWRITE created_at ON claim TYPE datetime DEFAULT time::now();
DEFINE INDEX OVERWRITE claimed_subject ON claim FIELDS subject UNIQUE;
DEFINE TABLE OVERWRITE plan SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE run ON plan TYPE record<agent_run>;
DEFINE FIELD OVERWRITE goal ON plan TYPE string;
DEFINE FIELD OVERWRITE version ON plan TYPE int DEFAULT 1;
DEFINE FIELD OVERWRITE steps ON plan TYPE array<object> DEFAULT [];
DEFINE FIELD OVERWRITE steps.*.id ON plan TYPE string;
DEFINE FIELD OVERWRITE steps.*.title ON plan TYPE string;
DEFINE FIELD OVERWRITE steps.*.status ON plan TYPE string;
DEFINE FIELD OVERWRITE steps.*.note ON plan TYPE string;
DEFINE FIELD OVERWRITE steps.*.evidence ON plan TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE steps.*.depends_on ON plan TYPE array<string> DEFAULT [];
DEFINE INDEX OVERWRITE plan_run ON plan FIELDS run UNIQUE;
DEFINE TABLE OVERWRITE wakeup SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE run ON wakeup TYPE record<agent_run>;
DEFINE FIELD OVERWRITE due_at ON wakeup TYPE datetime;
DEFINE FIELD OVERWRITE reason ON wakeup TYPE string;
DEFINE FIELD OVERWRITE status ON wakeup TYPE string ASSERT $value IN ['pending','fired','cancelled'];
DEFINE FIELD OVERWRITE task_name ON wakeup TYPE option<string>;
DEFINE FIELD OVERWRITE wake_on ON wakeup TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE fired_at ON wakeup TYPE option<datetime>;
DEFINE FIELD OVERWRITE version ON wakeup TYPE int DEFAULT 1;
DEFINE INDEX OVERWRITE wakeup_due ON wakeup FIELDS status, due_at;
DEFINE TABLE OVERWRITE action SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE run ON action TYPE option<record<agent_run>>;
DEFINE FIELD OVERWRITE actor ON action TYPE string;
DEFINE FIELD OVERWRITE reason ON action TYPE string;
DEFINE FIELD OVERWRITE kind ON action TYPE string;
DEFINE FIELD OVERWRITE entity ON action TYPE option<record>;
DEFINE FIELD OVERWRITE before ON action TYPE option<string>;
DEFINE FIELD OVERWRITE after ON action TYPE option<string>;
DEFINE FIELD OVERWRITE reversible ON action TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE undone_at ON action TYPE option<datetime>;
DEFINE FIELD OVERWRITE created_at ON action TYPE datetime DEFAULT time::now();
DEFINE TABLE OVERWRITE change_log SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE version ON change_log TYPE int;
DEFINE FIELD OVERWRITE kind ON change_log TYPE string;
DEFINE FIELD OVERWRITE entity ON change_log TYPE option<record>;
DEFINE FIELD OVERWRITE payload_json ON change_log TYPE string;
DEFINE FIELD OVERWRITE created_at ON change_log TYPE datetime DEFAULT time::now();
DEFINE INDEX OVERWRITE change_version ON change_log FIELDS version UNIQUE;
DEFINE TABLE OVERWRITE credential SCHEMAFULL;
DEFINE FIELD OVERWRITE label ON credential TYPE string;
DEFINE FIELD OVERWRITE domain ON credential TYPE string;
DEFINE FIELD OVERWRITE username ON credential TYPE string;
DEFINE FIELD OVERWRITE secret_reference ON credential TYPE string;
DEFINE FIELD OVERWRITE created_at ON credential TYPE datetime DEFAULT time::now();
DEFINE TABLE OVERWRITE invocation SCHEMAFULL;
DEFINE FIELD OVERWRITE instructions ON invocation TYPE string;
DEFINE FIELD OVERWRITE context ON invocation TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE due_at ON invocation TYPE datetime;
DEFINE FIELD OVERWRITE status ON invocation TYPE string;
DEFINE TABLE OVERWRITE ingestion_job SCHEMAFULL CHANGEFEED 7d INCLUDE ORIGINAL;
DEFINE FIELD OVERWRITE source ON ingestion_job TYPE option<record<source_file>>;
DEFINE FIELD OVERWRITE status ON ingestion_job TYPE string;
DEFINE FIELD OVERWRITE stage ON ingestion_job TYPE string;
DEFINE FIELD OVERWRITE error ON ingestion_job TYPE option<string>;
DEFINE FIELD OVERWRITE extractor_version ON ingestion_job TYPE string;
DEFINE FIELD OVERWRITE created_at ON ingestion_job TYPE datetime DEFAULT time::now();
DEFINE TABLE OVERWRITE current SCHEMAFULL TYPE RELATION IN skill OUT skill_version ENFORCED;
DEFINE TABLE OVERWRITE has_version SCHEMAFULL TYPE RELATION IN skill OUT skill_version ENFORCED;
DEFINE TABLE OVERWRITE supersedes SCHEMAFULL TYPE RELATION IN skill_version OUT skill_version ENFORCED;
DEFINE TABLE OVERWRITE affects SCHEMAFULL TYPE RELATION IN workflow_issue OUT skill | skill_version ENFORCED;
DEFINE TABLE OVERWRITE addresses SCHEMAFULL TYPE RELATION IN skill_change_proposal OUT workflow_issue ENFORCED;
DEFINE TABLE OVERWRITE for_skill SCHEMAFULL TYPE RELATION IN skill_change_proposal OUT skill ENFORCED;
DEFINE TABLE OVERWRITE based_on SCHEMAFULL TYPE RELATION IN skill_change_proposal OUT skill_version ENFORCED;
COMMIT TRANSACTION;
